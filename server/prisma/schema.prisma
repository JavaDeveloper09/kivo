generator client {
  provider = "prisma-client-js"
}

// PostgreSQL (Neon). DATABASE_URL: Neon'daki doğrudan (direct, "-pooler" olmayan) bağlantı adresi.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique // benzersiz, küçük harf: ahmet_42
  displayName  String            // herkes aynısını kullanabilir: "Ahmet"
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false) // site yöneticisi (duyuru atabilir)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resetTokens   PasswordResetToken[]
  memberships   Member[]
  messages      Message[]
  ownedServers  Server[]
  announcements Announcement[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // token'ın kendisi değil, hash'i saklanır
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ---------- Sunucular, kanallar, mesajlar ----------

model Server {
  id         String    @id @default(cuid())
  name       String
  inviteCode String    @unique // davet linkindeki kod
  ownerId    String
  owner      User      @relation(fields: [ownerId], references: [id])
  createdAt  DateTime  @default(now())
  members    Member[]
  channels   Channel[]
}

// Kullanıcı <-> sunucu üyeliği (çoka çok ilişki)
model Member {
  id       String   @id @default(cuid())
  role     String   @default("MEMBER") // "OWNER" | "MEMBER"
  userId   String
  serverId String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  server   Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([userId, serverId]) // aynı kişi aynı sunucuya iki kez katılamaz
}

model Channel {
  id        String    @id @default(cuid())
  name      String
  type      String    @default("TEXT") // "TEXT" | "VOICE"
  position  Int       @default(0)
  serverId  String
  server    Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  messages  Message[]
}

model Message {
  id        String   @id @default(cuid())
  content   String
  channelId String
  authorId  String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([channelId, createdAt]) // kanal geçmişini tarihe göre hızlı çekmek için
}

// ---------- Site geneli duyurular ----------

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
}