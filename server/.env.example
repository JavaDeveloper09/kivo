# Neon -> Connect -> "Connection pooling" KAPALI iken çıkan adres (içinde "-pooler" olmamalı).
# Sonundaki "&channel_binding=require" kısmını sil, "?sslmode=require" kalsın.
DATABASE_URL="postgresql://kullanici:sifre@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Uzun, rastgele bir değer koy: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="degistir-beni"
CLIENT_URL="http://localhost:5173"
PORT=4000

# Sesli sohbet (cloud.livekit.io -> proje -> Settings -> API Keys)
# SECRET'i kimseyle paylaşma, GitHub'a yükleme.
LIVEKIT_URL="wss://projen.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
